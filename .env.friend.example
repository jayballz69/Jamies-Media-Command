# Copy to .env; that local file is ignored by Git.
# Replace with the VM's specific LAN address for access from another computer.
# The default accepts connections only on the VM itself.
VM_LAN_IP=127.0.0.1
CM_PORT=8780
CM_DATA_PATH=./web-data
TZ=Etc/UTC

# For an HTTPS reverse proxy only: use 1 and its exact public origin.
CM_SECURE_COOKIE=0
CM_PUBLIC_ORIGIN=

# No passwords or API keys belong in this example.
# Choose your username and password in the browser on first open.
# Configure Plex, the curator and optional Arr services in the web UI.
